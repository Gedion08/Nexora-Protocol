{
  "name": "nexora-protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Starknet as the privacy layer for the multichain economy",
  "author": "Nexora Protocol Team",
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{json,md,cairo,ts,tsx,js,jsx}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "deploy:contracts": "bash scripts/deploy/contracts.sh",
    "deploy:demo": "bash scripts/deploy/demo.sh",
    "demo:record": "bash scripts/demo/record.sh",
    "strk20:register": "bash scripts/deploy/register-strk20.sh"
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
