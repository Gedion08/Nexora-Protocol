{
  "name": "@nexora-protocol/shared",
  "version": "0.1.0",
  "description": "Shared types, constants, and configuration for Nexora Protocol",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
