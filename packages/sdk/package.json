{
  "name": "@nexora-protocol/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Nexora Protocol — STRK20 privacy pool wrapper, viewing keys, shield/unshield, and note discovery",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ --ext .ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "js-sha3": "^0.13.0",
    "starknet": "^6.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-istanbul": "^1.2.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0",
    "xo": "^0.58.0"
  }
}
