{
  "name": "@nexora-protocol/relayer",
  "version": "0.1.0",
  "description": "Backend relayer service for Nexora Protocol — orchestrates bridge → shield flows via LayerSwap and STRK20 pool",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "nexora-relayer": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist",
    "db:migrate": "node dist/db/migrate.js",
    "db:reset": "node dist/db/migrate.js --reset"
  },
  "dependencies": {
    "@nexora-protocol/sdk": "workspace:*",
    "@nexora-protocol/shared": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "pg": "^8.11.3",
    "starknet": "^6.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^2.0.12",
    "supertest": "^7.0.0",
    "tsx": "^4.1.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  }
}
