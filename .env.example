# Environment Configuration
# Copy this file to .env and fill in real values before running any commands.
# NEVER commit .env to version control.

# =============================================================================
# Network
# =============================================================================
NEXORA_ENV=MAINNET

NEXT_PUBLIC_CHAIN_ID=SN_MAIN
NEXT_PUBLIC_RPC_URL=https://starknet-mainnet.g.alchemy.com/starknet/version/rpc/v0_10/YXIKBtHwuu_mxls9Zgphxp7vYeGroh44
NEXT_PUBLIC_POOL_ADDRESS=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a

# Sepolia (testing)
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://starknet-sepolia.g.alchemy.com/starknet/version/rpc/v0_10/YXIKBtHwuu_mxls9Zgphxp7vYeGroh44
NEXT_PUBLIC_SEPOLIA_POOL_ADDRESS=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a

# =============================================================================
# STRK20 Services
# =============================================================================
NEXT_PUBLIC_INDEXER_URL=
NEXT_PUBLIC_PROVER_URL=

# =============================================================================
# Privacy Hub
# =============================================================================
PRIVACY_HUB_ADDRESS=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a

# =============================================================================
# Bridge Adapters
# =============================================================================
LAYERSWAP_API_KEY=
LAYERSWAP_API_URL=https://api.layerswap.io

# StarkGate ( StarkGate integration via official API / relayer )
NEXT_PUBLIC_STARKGATE_API_URL=

# Orbiter
NEXT_PUBLIC_ORBITER_API_URL=https://www.orbiter.finance/api

# =============================================================================
# Wallet / Account
# =============================================================================
NEXT_PUBLIC_ENABLE_TESTNET=false

# =============================================================================
# Deterministic Accounts (Earn-Contracts Pattern)
# =============================================================================
VEIL_FACTORY_ADDRESS=
VEIL_IMPLEMENTATION_ADDRESS=

# =============================================================================
# Relayer (Backend)
# =============================================================================
RELAYER_PORT=3001
RELAYER_DB_URL=postgres://postgres:postgres@localhost:5432/nexora_relayer
RELAYER_PRIVATE_KEY=
RELAYER_STARKNET_ADDRESS=
RELAYER_INVENTORY_ADDRESS=
CORS_ORIGIN=*

# =============================================================================
# Tokens
# =============================================================================
USDC_TOKEN_ADDRESS=0x053c91253bc9682c04929ca02ed00b3e42340039d10f12a9d86e898b8b8b8b8b

# =============================================================================
# Timeouts and Retries
# =============================================================================
POLL_INTERVAL_MS=15000
TX_WAIT_TIMEOUT_MS=120000
MAX_RETRIES=3

# =============================================================================
# Paymaster
# =============================================================================
PAYMASTER_ADDRESS=
PAYMASTER_RPC_URL=

# =============================================================================
# Demo / Deployment
# =============================================================================
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_VERCEL_URL=

# =============================================================================
# Observability
# =============================================================================
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_ANALYTICS_ID=
LOG_LEVEL=info
